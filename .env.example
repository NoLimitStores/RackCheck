# RackCheck environment variables (voorbeeld). Kopieer naar .env.local voor
# lokaal gebruik en zet de echte waarden in Vercel voor productie.
# Zet nooit echte secrets in Git.

# Definitief productiedomein (voor canonicals, sitemap en Open Graph).
NEXT_PUBLIC_SITE_URL=https://rackcheck.nl

# Web3Forms access key voor het contact-/aanvraagformulier.
# BELANGRIJK: de recipient (ontvanger) wordt bepaald door het Web3Forms-account
# dat bij deze sleutel hoort. Zorg dat dat account de aanvragen aflevert bij
# t.krikhaar@hovuma.com. Zonder deze sleutel logt de site inzendingen alleen in
# development en toont hij lokaal een succesflow.
WEB3FORMS_ACCESS_KEY=

# Optioneel: Google Analytics 4 meet-ID. Leeg laten = geen tracking.
NEXT_PUBLIC_GA_ID=
